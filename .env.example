# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Local development: any Postgres instance.
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/myvanity"
# On Netlify you do NOT set this — Netlify DB injects NETLIFY_DB_URL and
# the build maps it across automatically.
DATABASE_URL="postgresql://postgres:password@localhost:5432/myvanity"

# ---------------------------------------------------------------------------
# Auth (NextAuth v5)
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"
# Only needed if auto-detection fails (e.g. behind a proxy). Netlify sets URL itself.
# AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Seeded admin account (used once by `npm run db:seed`)
# ---------------------------------------------------------------------------
# The seed refuses to run with a weak password unless SEED_ALLOW_WEAK=1.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-before-seeding"
ADMIN_EMAIL="admin@myvanity.com"

# ---------------------------------------------------------------------------
# Storefront contact (public — safe to commit real values)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="96170120160"
NEXT_PUBLIC_WHATSAPP_MESSAGE="Hi, I'm interested in this product. Please confirm availability."
