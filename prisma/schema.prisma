// My Vanity — data model
//
// Provider is PostgreSQL, which is what Netlify DB (powered by Neon) provisions.
// Locally, point DATABASE_URL at any Postgres instance. On Netlify the platform
// injects NETLIFY_DB_URL instead; scripts/prisma-with-db-url.mjs maps it onto
// DATABASE_URL for the build, and src/lib/prisma.ts falls back to it at runtime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Admin accounts. There is no customer login — shoppers order over WhatsApp.
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  email        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLogin    DateTime?

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  /// Money is stored as an exact decimal, never a float. The data layer converts
  /// it to a plain number before it crosses into a Client Component.
  price        Decimal  @db.Decimal(10, 2)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  /// Storage keys returned by `src/lib/storage`, not absolute URLs, so the same
  /// row works whether the bytes live on local disk or in Netlify Blobs.
  images       String[]
  /// Must be one of `images`; enforced by the Zod schema on write.
  mainImage    String
  isOutOfStock Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // No @@index([slug]) — @unique already creates one.
  @@index([categoryId])
  @@map("products")
}
